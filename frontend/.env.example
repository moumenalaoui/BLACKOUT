# Frontend build-time settings (Vite). Copy to frontend/.env for local
# `npm run dev` / `npm run build`. Only VITE_-prefixed values reach the browser
# bundle, and they are baked in at build time — they are public, never secrets.
# The Docker build takes the same two values as build args from the repo-root
# .env (see ../.env.example).

# Backend origin for API calls. Leave empty (the default) for same-origin, which
# is right whenever the backend serves this bundle — locally, and in the Docker
# setup. Set it only when the frontend is hosted separately, e.g.
#   VITE_API_BASE_URL=https://api.example.org
# and then add this site's origin to the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# Only needed if you enable Cesium Ion imagery or terrain in Globe.jsx.
# The globe currently runs with `imageryProvider: false`, so this can stay unset.
VITE_CESIUM_ION_TOKEN=

# Dev server only (not baked into the bundle): where `npm run dev` proxies /api
# and /health. Defaults to the backend's default address.
# DEV_API_PROXY_TARGET=http://localhost:3001
