# Backend configuration. This file is gitignored — .env.example is the committed template.
# The deployment is public and read-only: there are no auth credentials.

# Optional data-source tokens. If unset, that source is skipped and renders
# empty (a loud WARNING is logged at boot).
CLOUDFLARE_API_TOKEN=your_token_here
PULSE_API_TOKEN=your_token_here

# Optional overrides. Defaults suit `cargo run` from backend/.
# DATABASE_PATH=mena_ai.db
# SEED_DIR=data/seed
# STATIC_DIR=../frontend/dist
# HEALTH_MAX_AGE_DAYS=2
# FETCH_INTERVAL_HOURS=6
# PORT=3001

# Satellite tracking (CelesTrak, no token needed). Refresh cadence matches
# CelesTrak's own ~2h GP/SupGP update cycle — set lower only for local testing,
# since CelesTrak rate-limits repeat downloads of high-traffic groups.
# SATELLITE_CATALOG_REFRESH_HOURS=2
# `group:category` pairs, comma-separated. Earlier groups win the category tag
# when a NORAD ID appears in more than one. Starlink's SpaceX-derived
# supplemental data is always fetched in addition to this list and overrides a
# general-GP record for the same NORAD ID.
# SATELLITE_GROUPS=starlink:starlink,gps-ops:navigation,galileo:navigation,glo-ops:navigation,beidou:navigation,military:military,resource:earthobs,stations:stations,science:stations,geo:geo,active:other
