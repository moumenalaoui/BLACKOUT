# Backend configuration. This file is gitignored — .env.example is the committed template.
# The deployment is public and read-only: there are no auth credentials.

# Optional data-source tokens. If unset, that source is skipped and renders
# empty (a loud WARNING is logged at boot). CLOUDFLARE_API_TOKEN gates two
# features: Radar outage annotations and the HTTP/3 protocol-share signal.
CLOUDFLARE_API_TOKEN=your_token_here
PULSE_API_TOKEN=your_token_here

# Optional overrides. Defaults suit `cargo run` from backend/.
# DATABASE_PATH=mena_ai.db
# SEED_DIR=data/seed
# STATIC_DIR=../frontend/dist
# HEALTH_MAX_AGE_DAYS=2
# FETCH_INTERVAL_HOURS=6
# PORT=3001

# Satellite tracking (CelesTrak + SatNOGS, no token needed). Refresh cadence
# matches CelesTrak's own ~2h GP/SupGP update cycle — set lower only for local
# testing, since CelesTrak rate-limits repeat downloads of high-traffic groups.
# The catalog is persistent and additive (see README: Satellite catalog
# persistence), so a restart inside this window performs no fetch at all.
# SATELLITE_CATALOG_REFRESH_HOURS=2

# Age past which an object's orbital data is reported as `stale` by
# /api/satellites and /api/satellites/status. Annotation only — a stale
# satellite is still served; nothing is ever hidden or deleted for being old.
# SATELLITE_STALE_AFTER_HOURS=24

# Shrinkage guard. A *successful* group response smaller than this fraction of
# that group's established size is treated as partial: its records are still
# merged (merging can only improve a row), but it does not get to lower the
# baseline used to judge the next response. Guards against a truncated
# response being mistaken for a genuinely smaller catalog. Relative on
# purpose — the real catalog size changes constantly, so no absolute floor
# would stay correct.
# SATELLITE_GROUP_MIN_RETAIN_RATIO=0.5
# `group:category` pairs, comma-separated. Earlier groups win the category tag
# when a NORAD ID appears in more than one. Starlink's SpaceX-derived
# supplemental data is always fetched in addition to this list and overrides a
# general-GP record for the same NORAD ID.
# SATELLITE_GROUPS=starlink:starlink,gps-ops:navigation,galileo:navigation,glo-ops:navigation,beidou:navigation,military:military,resource:earthobs,stations:stations,science:stations,geo:geo,active:other

# Precision/leading-indicator signals — HTTP/3 (QUIC) protocol-share via
# Cloudflare Radar (reuses CLOUDFLARE_API_TOKEN above) and BGP prefix
# visibility via RIPEstat (no token needed). These run on their own faster
# loop, independent of FETCH_INTERVAL_HOURS, since the whole point is to
# catch a protocol collapse or route withdrawal while it's happening.
# PRECISION_FETCH_INTERVAL_HOURS=1
# RIPESTAT_SOURCEAPP=blackout-globe-tool
