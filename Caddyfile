# Reverse proxy for docker-compose.yml. DOMAIN and ACME_EMAIL come from .env.
#
# Caddy obtains and renews the TLS certificate for DOMAIN on its own (ports 80
# and 443 must reach this host), redirects HTTP to HTTPS, and serves HTTP/3.
# With DOMAIN=localhost it uses its internal CA instead, for local testing.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# No `encode`: the app already gzips its responses and serves precompressed
	# bundle files, and Caddy would only re-check what is already compressed.
	#
	# No `log` either, deliberately: the privacy page promises that requests
	# are not logged, and Caddy writes no access log unless told to.

	# Cache API responses at the Cloudflare edge for 5 minutes, browsers for 1.
	# Satellites are excluded here and get a shorter window below.
	@api {
		path /api/*
		not path /api/satellites*
	}
	header @api {
		Cache-Control "public, max-age=60, s-maxage=300"
		defer
	}

	# Satellite position and status data changes fast: 30s edge, 10s browser.
	header /api/satellites* {
		Cache-Control "public, max-age=10, s-maxage=30"
		defer
	}

	reverse_proxy app:3001
}
